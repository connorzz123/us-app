# ── AI 调用 ──
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_AUTH_TOKEN=sk-你的DeepSeek密钥
ANTHROPIC_MODEL=deepseek-v4-pro

# ── 安全防护 ──
# 主访问码：岩哥自己用，永不过期不限次（建议长随机串，如 US-XXXXXXXX）
MASTER_CODE=
# 管理后台密钥：进入 /admin 页面用，与访问码独立（建议另一组长随机串）
ADMIN_KEY=
# 每日 AI token 预算熔断线（超出后 AI 调用直接拒绝）
DAILY_TOKEN_BUDGET=300000
# 每日新建复盘数上限
DAILY_SESSION_LIMIT=20
# 单 IP 每小时可创建复盘数
RATE_LIMIT_PER_IP=5
